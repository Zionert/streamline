{
  "name": "@streamline/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Zod schemas, types and constants for StreamLine",
  "type": "module",
  "exports": {
    ".": {
      "@streamline/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "pnpm build && node bench/rank.bench.ts"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "vitest": "5.1.0"
  }
}
