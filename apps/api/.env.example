# Runtime environment: development | test | production
NODE_ENV=development
# HTTP port of the API
PORT=4000
# PostgreSQL connection string (matches the docker-compose.yml defaults)
DATABASE_URL=postgresql://streamline:streamline@localhost:5432/streamline?schema=public
# Allowed frontend origin(s) for CORS, comma-separated
CORS_ORIGIN=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Authentication ---
# Secret for signing access tokens (HS256), at least 32 characters.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
# Access token lifetime in seconds (default 15 minutes)
ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in seconds (default 7 days)
REFRESH_TOKEN_TTL_SECONDS=604800
# Seconds during which reuse of a just-rotated refresh token counts as a concurrent refresh
# (e.g. several tabs) instead of theft; 0 disables the grace window
REFRESH_REUSE_GRACE_SECONDS=30
# Path of the refresh cookie as seen by the browser (the web dev proxy serves the API under /api)
REFRESH_COOKIE_PATH=/api/auth
# bcrypt cost factor (4-15); must be at least 12 when NODE_ENV=production
BCRYPT_COST=12
# Rate limiting of /auth/* per client IP
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Max requests per window to any /auth/* endpoint
AUTH_RATE_LIMIT_MAX=100
# Max failed login/register attempts per window
AUTH_CREDENTIALS_RATE_LIMIT_MAX=10

# --- Tests ---
# Optional: database for integration tests (name must end with _test). When unset, tests use
# DATABASE_URL with "_test" appended to the database name. The database is created automatically.
# DATABASE_URL_TEST=postgresql://streamline:streamline@localhost:5432/streamline_test?schema=public
