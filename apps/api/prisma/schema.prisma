// Prisma schema for StreamLine.
// Models are added together with the features that need them.
// The datasource URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String           @id @default(cuid())
  /// Stored normalized (trimmed, lowercase).
  email           String           @unique
  passwordHash    String
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  refreshTokens   RefreshToken[]
  memberships     BoardMember[]
  ownedBoards     Board[]          @relation("BoardOwner")
  assignedCards   Card[]           @relation("CardAssignee")
  cardMoves       CardTransition[] @relation("CardTransitionMovedBy")
  comments        Comment[]        @relation("CommentAuthor")
  activities      Activity[]       @relation("ActivityActor")
  aiConversations AiConversation[]
  aiUsage         AiUsage[]
}

/// Opaque refresh tokens; only the SHA-256 hash of the token is stored.
model RefreshToken {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String        @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Token issued in exchange for this one during rotation.
  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenRotation")
  createdAt    DateTime      @default(now())

  @@index([userId])
}

/// Role of a user on a board; permissions per role are defined in @streamline/shared.
enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Board {
  id              String           @id @default(cuid())
  name            String
  /// Prefix of card keys (e.g. "SL" in "SL-12"): 2-5 uppercase letters, unique per owner.
  key             String
  /// The user holding the OWNER membership; kept in sync with it.
  ownerId         String
  owner           User             @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  /// Number given to the next card; only ever incremented, so numbers are never reused.
  nextCardNumber  Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  members         BoardMember[]
  columns         Column[]
  cards           Card[]
  transitions     CardTransition[]
  labels          Label[]
  comments        Comment[]
  activities      Activity[]
  aiConversations AiConversation[]

  @@unique([ownerId, key])
}

/// Membership of a user in a board. Each board has at most one OWNER, which is
/// enforced by the partial unique index "BoardMember_one_owner_per_board" (defined in the
/// migration SQL, as Prisma cannot express partial indexes).
model BoardMember {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([boardId, userId])
  @@index([userId])
}

/// Workflow category of a column; analytics and WIP rules use it instead of the title.
enum ColumnCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

// Board column, ordered by `rank` (keys from @streamline/shared, computed by the server).
// Hand-written in the migration SQL, because Prisma cannot express it:
// - "rank" uses COLLATE "C", so ORDER BY "rank" equals JavaScript string comparison;
// - "Column_boardId_rank_key" is a DEFERRABLE INITIALLY IMMEDIATE unique constraint, checked at
//   the end of each statement instead of after every row, so a rebalance can rewrite all ranks
//   of a board in a single UPDATE. Prisma does not diff collation or deferrability, so
//   `prisma migrate dev` reports no drift.
model Column {
  id              String           @id @default(cuid())
  boardId         String
  board           Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title           String
  rank            String
  category        ColumnCategory   @default(TODO)
  /// Maximum number of cards; null = no limit.
  wipLimit        Int?
  /// When true the WIP limit blocks adding cards instead of only warning.
  wipStrict       Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  /// Deleting a column that still holds cards is refused by the service; NO ACTION guards it too.
  cards           Card[]
  /// Transitions keep their history when a column is deleted (the reference becomes null).
  transitionsFrom CardTransition[] @relation("CardTransitionFrom")
  transitionsTo   CardTransition[] @relation("CardTransitionTo")

  @@unique([boardId, rank])
}

enum CardPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Card in a column, ordered by `rank` within the column. Like Column, hand-written in the
// migration SQL: "rank" uses COLLATE "C" and "Card_columnId_rank_key" is a DEFERRABLE INITIALLY
// IMMEDIATE unique constraint (a rebalance rewrites all ranks of a column in one UPDATE).
model Card {
  id          String           @id @default(cuid())
  /// Denormalized from the column for board-wide queries.
  boardId     String
  board       Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId    String
  column      Column           @relation(fields: [columnId], references: [id], onDelete: NoAction)
  /// Sequential per board (from Board.nextCardNumber); the card key is "<board key>-<number>".
  number      Int
  title       String
  description String?
  rank        String
  priority    CardPriority     @default(MEDIUM)
  assigneeId  String?
  assignee    User?            @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Calendar date without time zone.
  dueDate     DateTime?        @db.Date
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  transitions CardTransition[]
  labels      CardLabel[]
  comments    Comment[]

  @@unique([boardId, number])
  @@unique([columnId, rank])
  @@index([assigneeId])
}

/// Every move of a card into a column (including its creation, with fromColumnId = null);
/// the source of flow analytics. Written in the same transaction as the move.
model CardTransition {
  id           String   @id @default(cuid())
  cardId       String
  card         Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  boardId      String
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Null for the creation of the card, or when the column was deleted later.
  fromColumnId String?
  fromColumn   Column?  @relation("CardTransitionFrom", fields: [fromColumnId], references: [id], onDelete: SetNull)
  /// Always written; null only when the column was deleted later.
  toColumnId   String?
  toColumn     Column?  @relation("CardTransitionTo", fields: [toColumnId], references: [id], onDelete: SetNull)
  /// Null when the user's account was deleted later.
  movedById    String?
  movedBy      User?    @relation("CardTransitionMovedBy", fields: [movedById], references: [id], onDelete: SetNull)
  movedAt      DateTime @default(now())

  @@index([boardId, movedAt])
  @@index([cardId, movedAt])
  /// Used by ON DELETE SET NULL when a column is deleted.
  @@index([fromColumnId])
  @@index([toColumnId])
}

/// Fixed palette of label colors; clients map each name to theme-aware colors.
enum LabelColor {
  GREEN
  YELLOW
  ORANGE
  RED
  PURPLE
  BLUE
  SKY
  LIME
  PINK
  GRAY
}

// Label defined per board and attached to cards through CardLabel. Names are unique per board
// regardless of case: "Label_boardId_lower_name_key" is a unique index on ("boardId", lower("name"))
// hand-written in the migration SQL (Prisma cannot express expression indexes); it also serves
// the lookups by board.
model Label {
  id        String      @id @default(cuid())
  boardId   String
  board     Board       @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Trimmed, 1-30 characters.
  name      String
  color     LabelColor
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  cards     CardLabel[]
}

/// A label attached to a card; removed together with either of them.
model CardLabel {
  cardId  String
  card    Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  labelId String
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([cardId, labelId])
  /// Used when a label is deleted (cascade) and to find the cards carrying a label.
  @@index([labelId])
}

model Comment {
  id        String    @id @default(cuid())
  cardId    String
  card      Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  /// Denormalized from the card for board-wide scoping.
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Null when the author's account was deleted later.
  authorId  String?
  author    User?     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  /// Trimmed, 1-5000 characters.
  body      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Set when the author changes the body; null for a comment never edited.
  editedAt  DateTime?

  /// Chronological listing of a card's comments (keyset pagination on createdAt, id).
  @@index([cardId, createdAt, id])
  /// Used by ON DELETE CASCADE when a board is deleted.
  @@index([boardId])
}

/// Kind of a board activity entry; the shape of `Activity.payload` depends on it.
enum ActivityType {
  CARD_CREATED
  CARD_UPDATED
  CARD_MOVED
  CARD_DELETED
  CARD_LABEL_ADDED
  CARD_LABEL_REMOVED
  COMMENT_ADDED
  COLUMN_CREATED
  COLUMN_RENAMED
  COLUMN_MOVED
  COLUMN_SETTINGS_CHANGED
  COLUMN_DELETED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  MEMBER_LEFT
}

/// Board activity log ("who did what, when"), written in the same transaction as the change it
/// describes. The payload is a self-describing snapshot (card key and title, column and member
/// names, ...), so entries stay readable after the referenced rows are changed or deleted.
model Activity {
  id        String       @id @default(cuid())
  boardId   String
  board     Board        @relation(fields: [boardId], references: [id], onDelete: Cascade)
  /// Null when the user's account was deleted later.
  actorId   String?
  actor     User?        @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  type      ActivityType
  /// The card the entry is about; a plain column without a foreign key, so the history of a card
  /// survives its deletion.
  cardId    String?
  payload   Json
  createdAt DateTime     @default(now())

  /// Board feed and card feed, newest first (keyset pagination on createdAt, id).
  @@index([boardId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([cardId, createdAt(sort: Desc), id(sort: Desc)])
}

/// Purpose of an AI assistant conversation.
enum AiConversationKind {
  /// The assistant panel of a board: one conversation per user and board.
  BOARD_CHAT
  /// "New project with assistant": a conversation without a board.
  PROJECT_SESSION
}

// A conversation with the AI assistant, private to its author. Hand-written in the migration SQL
// (Prisma cannot express it): the check constraint "AiConversation_kind_board_check" requires a
// board for BOARD_CHAT and none for PROJECT_SESSION. The unique (userId, boardId) allows one board
// chat per user and board; project sessions have a null boardId, which PostgreSQL treats as
// distinct, so a user may have several of them.
model AiConversation {
  id        String             @id @default(cuid())
  userId    String
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AiConversationKind
  /// Set for BOARD_CHAT; the conversation is deleted together with the board.
  boardId   String?
  board     Board?             @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  messages  AiMessage[]

  @@unique([userId, boardId])
  /// Used by ON DELETE CASCADE when a board is deleted.
  @@index([boardId])
}

/// Author of an AI assistant message (TOOL carries the result of a tool call).
enum AiMessageRole {
  USER
  ASSISTANT
  TOOL
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           AiMessageRole
  /// Text of the message; empty for an assistant message that only calls a tool.
  content        String
  /// Name of the called tool (ASSISTANT calling a tool, or TOOL answering it).
  toolName       String?
  /// Id the model gave the tool call; pairs a TOOL message with the call it answers.
  toolCallId     String?
  /// Arguments of the tool call as sent by the model.
  toolArgs       Json?
  /// Result of the tool call (TOOL).
  toolResult     Json?
  createdAt      DateTime       @default(now())

  /// Conversation history, newest first (keyset pagination on createdAt, id).
  @@index([conversationId, createdAt(sort: Desc), id(sort: Desc)])
}

/// AI assistant usage per user and calendar day (UTC), checked against the daily limits.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Calendar day (UTC) without time.
  day              DateTime @db.Date
  requestCount     Int      @default(0)
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, day])
}
