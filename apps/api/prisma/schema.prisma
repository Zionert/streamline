// Prisma schema for StreamLine.
// Models are added together with the features that need them.
// The datasource URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(cuid())
  /// Stored normalized (trimmed, lowercase).
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  memberships   BoardMember[]
}

/// Opaque refresh tokens; only the SHA-256 hash of the token is stored.
model RefreshToken {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String        @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  /// Token issued in exchange for this one during rotation.
  replacedById String?       @unique
  replacedBy   RefreshToken? @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshToken? @relation("RefreshTokenRotation")
  createdAt    DateTime      @default(now())

  @@index([userId])
}

/// Role of a user on a board; permissions per role are defined in @streamline/shared.
enum BoardRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Board {
  id        String        @id @default(cuid())
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  members   BoardMember[]
  columns   Column[]
}

/// Membership of a user in a board. Each board has exactly one OWNER, which is additionally
/// enforced by the partial unique index "BoardMember_one_owner_per_board" (defined in the
/// migration SQL, as Prisma cannot express partial indexes).
model BoardMember {
  id        String    @id @default(cuid())
  boardId   String
  board     Board     @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      BoardRole
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([boardId, userId])
  @@index([userId])
}

/// Workflow category of a column; analytics and WIP rules use it instead of the title.
enum ColumnCategory {
  BACKLOG
  TODO
  IN_PROGRESS
  DONE
}

// Board column, ordered by `rank` (keys from @streamline/shared, computed by the server).
// Hand-written in the migration SQL, because Prisma cannot express it:
// - "rank" uses COLLATE "C", so ORDER BY "rank" equals JavaScript string comparison;
// - "Column_boardId_rank_key" is a DEFERRABLE INITIALLY IMMEDIATE unique constraint, checked at
//   the end of each statement instead of after every row, so a rebalance can rewrite all ranks
//   of a board in a single UPDATE. Prisma does not diff collation or deferrability, so
//   `prisma migrate dev` reports no drift.
model Column {
  id        String         @id @default(cuid())
  boardId   String
  board     Board          @relation(fields: [boardId], references: [id], onDelete: Cascade)
  title     String
  rank      String
  category  ColumnCategory @default(TODO)
  /// Maximum number of cards; null = no limit.
  wipLimit  Int?
  /// When true the WIP limit blocks adding cards instead of only warning.
  wipStrict Boolean        @default(false)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([boardId, rank])
}
