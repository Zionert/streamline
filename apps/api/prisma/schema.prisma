// Prisma schema for StreamLine.
// Models are added together with the features that need them (see docs/DATABASE.md).
// The datasource URL is configured in prisma.config.ts (DATABASE_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}
